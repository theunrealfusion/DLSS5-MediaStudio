#include <windows.h>
#include "src/resource.h"

// Application Icon
IDI_APP_ICON ICON "app.ico"

// Embedded Runtime Dependencies for zero-dependency standalone execution
IDR_VSR_DLL      RCDATA "../bin/Windows/x64/rel/nvngx_vsr.dll"
IDR_TRUEHDR_DLL  RCDATA "../bin/Windows/x64/rel/nvngx_truehdr.dll"
IDR_SHADERS_HLSL RCDATA "src/render/Shaders.hlsl"

// Version Information
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,1,0,0
PRODUCTVERSION  1,1,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "TheUnrealFusion / Keshav Sharma"
            VALUE "FileDescription",  "NVIDIA RTX DLSS-5 Video Studio"
            VALUE "FileVersion",      "1.1.0.0"
            VALUE "InternalName",     "RTX_DLSS5_Studio"
            VALUE "LegalCopyright",   "Copyright (C) 2026. All rights reserved."
            VALUE "OriginalFilename", "RTX_DLSS5_Studio.exe"
            VALUE "ProductName",      "RTX DLSS-5 Video Studio"
            VALUE "ProductVersion",   "1.1.0.0"
            VALUE "Comments",         "Optimized for NVIDIA GeForce RTX 5090 Blackwell & RTX Series"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
