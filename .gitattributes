# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Windows-specific files should keep CRLF
*.sln text eol=crlf
*.vcxproj text eol=crlf
*.vcxproj.filters text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# C++ and Shader source files
*.h text eol=lf
*.cpp text eol=lf
*.hlsl text eol=lf

# Documentation and Configuration
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf
*.json text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.pdf binary
*.mp4 binary
*.yuv binary
*.dll binary
*.exe binary
*.lib binary
